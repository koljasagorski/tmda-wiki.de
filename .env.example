# tmda-wiki.de — Laufzeit-Config für den Bun-Server auf node1 (src/server.js).
# Auf der VM als /home/admin/tmda-wiki/.env (chmod 600). Secrets NIE committen.

# Öffentliche Site-URL (für canonical/SEO/Sitemap)
SITE_URL=https://tmda-wiki.de

# YouTube (für /api/latest-video). Playlist hat Vorrang vor Channel.
YOUTUBE_CHANNEL_ID=
YOUTUBE_PLAYLIST_ID=

# Cloudflare Turnstile (Bot-Schutz im Chat). SECRET ist optional —
# ohne Secret läuft der Chat, aber ohne Challenge alle N Fragen.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_QUESTION_THRESHOLD=6

# KI-Chat: bevorzugt Groq (schnell, free tier). Ohne GROQ_API_KEY → Fallback Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Kontext-Budgets (Zeichen) — Defaults passen unter Groqs Free-Tier (6000 TPM).
AI_WIKI_CHARS=9000
AI_TRANSCRIPT_CHARS=4000
AI_SYSTEM_CHARS=15000

# Self-hosted Ollama (Fallback, nur falls GROQ_API_KEY leer)
AI_MODEL=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434

# HTTP-Port des Bun-Servers (hinter Caddy)
PORT=3000
